---
import "../styles/tailwind.css";
import FileUploader from "../components/FileUploader"



---
<html lang="hu" class="h-full dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WebP Képkonvertáló – Gyors, Biztonságos, SEO-Optimalizált</title>
    <meta name="description" content="Professzionális WebP képkonvertáló 100% kliens oldali feldolgozással. Automatikus optimalizálás, magyar ékezet kezelés, 85-95% fájlméret csökkentés. Teljesen ingyenes." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
    :root {
  /* LIGHT MODE - Szemkímélő "Soft Slate" */
  
  /* Színek: Kicsit mélyebbek, hogy a szürke alapon is jól látszódjanak */
  --color-primary: #0e7490; /* Cyan-700: Sötétebb, elegánsabb kék */
  --color-accent: #0891b2;
  --color-success: #059669; /* Emerald-600 */
  --color-danger: #dc2626;  /* Red-600 */

  /* HÁTTÉR ÉS FELÜLETEK - A lényeg itt van: */
  --color-bg: #e2e8f0;      /* Slate-200: Határozott világosszürke háttér */
  --color-surface: #f1f5f9; /* Slate-100: A kártyák sem fehérek, hanem törtfehérek */
  
  /* Szöveg */
  --color-text: #1e293b;       /* Slate-800: Nem koromfekete, hanem mélyszürke */
  --color-text-muted: #64748b; /* Slate-500 */
  --color-border: #cbd5e1;     /* Slate-300: Kicsit sötétebb keret a szürke kártyákhoz */

  /* Egyéb */
  --font-display: 'Manrope', sans-serif;
  --font-body: 'Manrope', sans-serif;
  --radius: 16px;

  /* Árnyék: Mivel a háttér sötétebb, az árnyéknak is erősebbnek kell lennie picit */
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

  /* Gradiensek */
  --gradient-primary: linear-gradient(135deg, #0e7490 0%, #0891b2 100%);
  --gradient-accent: linear-gradient(135deg, #0891b2 0%, #22d3ee 100%);
  --gradient-success: linear-gradient(135deg, #059669 0%, #34d399 100%);
}

:root.dark {
  /* DARK MODE - Ez maradt a szép mély/neon verzió */
  --color-primary: #22d3ee;
  --color-accent: #67e8f9;
  --color-success: #34d399;
  --color-danger: #f87171;
  --color-bg: #0f172a;
  --color-surface: #1e293b;
  --color-surface-elevated: #334155;
  --color-text: #f1f5f9;
  --color-text-muted: #94a3b8;
  --color-border: #334155;
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.4);
  --gradient-primary: linear-gradient(135deg, #0e7490 0%, #22d3ee 100%);
  --gradient-accent: linear-gradient(135deg, #0891b2 0%, #67e8f9 100%);
  --gradient-success: linear-gradient(135deg, #059669 0%, #34d399 100%);
}

      /* Smooth transitions for theme changes */
      * {
        transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
      }

      /* Micro-interactions */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes scaleIn {
        from {
          opacity: 0;
          transform: scale(0.98) translateY(10px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes shimmer {
        0% {
          background-position: -1000px 0;
        }
        100% {
          background-position: 1000px 0;
        }
      }

      .animate-fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
      }

      .animate-scale-in {
        animation: scaleIn 0.5s ease-out forwards;
      }

      .delay-100 { animation-delay: 0.1s; opacity: 0; }
      .delay-200 { animation-delay: 0.2s; opacity: 0; }
      .delay-300 { animation-delay: 0.3s; opacity: 0; }
      .delay-400 { animation-delay: 0.4s; opacity: 0; }
      .delay-500 { animation-delay: 0.5s; opacity: 0; }
      .delay-600 { animation-delay: 0.6s; opacity: 0; }

      /* Hero particles canvas */
      #hero-particles {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }

      .hero-container {
        position: relative;
        z-index: 1;
      }

      /* Bento card hover effects */
      .bento-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .bento-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
      }

      .bento-card:hover .card-icon {
        transform: scale(1.05);
      }

      .card-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* Button hover effects */
      .btn-primary {
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        transition: left 0.6s ease;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(99, 102, 241, 0.3);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      .btn-primary:hover::before {
        left: 100%;
      }

      .btn-secondary {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .btn-secondary:hover {
        transform: translateY(-2px);
        background-color: var(--color-secondary);
        color: var(--color-on-secondary);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
      }

      .btn-secondary:active {
        transform: translateY(0);
      }

      /* Dark mode toggle */
      .theme-toggle {
        width: 56px;
        height: 28px;
        border-radius: 14px;
        background: var(--color-border);
        position: relative;
        cursor: pointer;
        transition: background 0.3s;
      }

      .theme-toggle:hover {
        background: var(--color-accent);
      }

      .theme-toggle::after {
        content: '🌙';
        position: absolute;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--color-surface);
        top: 2px;
        left: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow);
      }

      :root.dark .theme-toggle::after {
        left: 30px;
        content: '☀️';
      }

      /* Gradient text */
      .gradient-text {
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .gradient-accent-text {
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Badge shimmer effect */
      .badge-shimmer {
        background: linear-gradient(90deg,
          var(--color-text-muted) 0%,
          var(--color-accent) 50%,
          var(--color-text-muted) 100%
        );
        background-size: 200% 100%;
        animation: shimmer 3s infinite;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Stats number animation */
      @keyframes countUp {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.9);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .stat-number {
        animation: countUp 0.8s ease-out forwards;
      }

      /* FAQ accordion */
      .faq-item {
        transition: all 0.3s ease;
      }

      .faq-item:hover {
        background: var(--color-border);
      }

      /* Navigation link hover */
      .nav-link {
        position: relative;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: var(--color-accent);
        transition: width 0.3s ease;
      }

      .nav-link:hover::after {
        width: 80%;
      }

      .nav-link:hover {
        color: var(--color-accent) !important;
        transform: translateY(-1px);
      }

      /* Comparison card interactions */
      .comparison-card .wp-section {
        transition: all 0.3s ease;
      }

      .comparison-card .astro-section {
        transition: all 0.3s ease;
      }

      .comparison-card:hover .wp-section {
        transform: translateX(-4px);
        opacity: 0.8;
      }

      .comparison-card:hover .astro-section {
        transform: translateX(4px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
      }

      
    </style>
    <script>
      // Dark mode toggle
      const initTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const html = document.documentElement;

        if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
          html.classList.add('dark');
          html.classList.remove('light');
        } else if (savedTheme === 'light') {
          html.classList.add('light');
          html.classList.remove('dark');
        }
      };

      const toggleTheme = () => {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');

        if (isDark) {
          html.classList.remove('dark');
          html.classList.add('light');
          localStorage.setItem('theme', 'light');
        } else {
          html.classList.remove('light');
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      };

      // Initialize on load
      initTheme();

      // Attach toggle handler
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('theme-toggle');
        if (toggle) {
          toggle.addEventListener('click', toggleTheme);
        }
      });
    </script>
    <script>
      // @ts-ignore
      import Alpine from 'alpinejs';
      // @ts-ignore
      import collapse from '@alpinejs/collapse';
      // @ts-ignore
      Alpine.plugin(collapse);
      // @ts-ignore
      window.Alpine = Alpine;
      Alpine.start();
    </script>
    <script>
      // @ts-ignore
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      // Initialize Lenis smooth scroll
      // @ts-ignore
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
        infinite: false,
      });

      // Request animation frame loop
      // @ts-ignore
      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Anchor link smooth scrolling
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
          // @ts-ignore
          anchor.addEventListener('click', function (e) {
            // @ts-ignore
            const href = this.getAttribute('href');
            if (href && href !== '#') {
              e.preventDefault();
              const target = document.querySelector(href);
              if (target) {
                lenis.scrollTo(target, {
                  offset: -80,
                  duration: 1.5
                });
              }
            }
          });
        });
      });
    </script>
  </head>
  <body class="min-h-full antialiased" style="background-color: var(--color-bg); color: var(--color-text); font-family: var(--font-body);">
    <!-- Navigation -->
    <nav class="absolute w-full top-0 z-50" x-data="{ menuOpen: false }">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-end h-16 gap-3">
          <!-- Theme Toggle -->
          <div id="theme-toggle" class="theme-toggle"></div>

          <!-- Menu Button -->
          <div class="relative">
            <button
              @click="menuOpen = !menuOpen"
              class="flex flex-col gap-1.5 w-10 h-10 items-center justify-center rounded-lg hover:opacity-70 transition-opacity"
              style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
            >
              <span class="w-5 h-0.5 transition-all" style="background-color: var(--color-text);" :class="{ 'rotate-45 translate-y-2': menuOpen }"></span>
              <span class="w-5 h-0.5 transition-all" style="background-color: var(--color-text);" :class="{ 'opacity-0': menuOpen }"></span>
              <span class="w-5 h-0.5 transition-all" style="background-color: var(--color-text);" :class="{ '-rotate-45 -translate-y-2': menuOpen }"></span>
            </button>

            <!-- Dropdown Menu -->
            <div
              x-show="menuOpen"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
              x-transition:enter-end="opacity-100 scale-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 scale-100"
              x-transition:leave-end="opacity-0 scale-95"
              @click.away="menuOpen = false"
              class="absolute right-0 mt-2 w-48 rounded-xl overflow-hidden"
              style="background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow-lg);"
            >
              <div class="py-2">
                <a href="#features" @click="menuOpen = false" class="block px-4 py-2.5 text-sm font-medium transition-colors hover:opacity-70" style="color: var(--color-text);">Funkciók</a>
                <a href="#benefits" @click="menuOpen = false" class="block px-4 py-2.5 text-sm font-medium transition-colors hover:opacity-70" style="color: var(--color-text);">Előnyök</a>
                <a href="#faq" @click="menuOpen = false" class="block px-4 py-2.5 text-sm font-medium transition-colors hover:opacity-70" style="color: var(--color-text);">GYIK</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" class="hero pt-24 pb-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
      <!-- Particle animation canvas -->
      <canvas id="hero-particles"></canvas>

      <div class="max-w-4xl mx-auto hero-container">
        <!-- Kompakt cím -->
        <div class="text-center mb-8">
          <div class="inline-block px-4 py-2 rounded-full text-xs font-semibold mb-4 animate-fade-in-up" style="background-color: var(--color-surface); color: var(--color-primary); box-shadow: var(--shadow); border: 1px solid var(--color-border);">
            100% privát, kliens oldali feldolgozás
          </div>

          <h1 class="text-3xl md:text-4xl font-bold animate-fade-in-up delay-100" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
            WebP Képkonvertáló
          </h1>
        </div>

        <!-- FileUploader - teljes szélesség -->
        <div class="animate-fade-in-up delay-200">
          <FileUploader client:load />
        </div>
      </div>
    </section>

    <!-- Section Divider -->
    <div class="h-px w-full" style="background: linear-gradient(90deg, transparent 0%, var(--color-border) 50%, transparent 100%);"></div>

    <!-- Features Section -->
    <section id="features" class="py-20 px-4 sm:px-6 lg:px-8" style="background-color: var(--color-surface);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">
            Funkciók
          </h2>
          <p class="text-base md:text-lg max-w-2xl mx-auto" style="color: var(--color-text-muted);">
            Hogyan működik?
          </p>
        </div>

        <!-- Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Feature 1: Drag & Drop -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow);">
            <div class="card-icon mb-4" style="background: var(--gradient-primary);">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">Drag & Drop</h3>
            <p class="leading-relaxed" style="color: var(--color-text-muted);">
              Húzd rá a képeket a feltöltő területre vagy kattints a fájlok kiválasztásához. Egyszerre akár 10 képet is feltölthetsz.
            </p>
          </div>

          <!-- Feature 2: Auto Optimization -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow);">
            <div class="card-icon mb-4" style="background: var(--gradient-primary);">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">Állítható minőség</h3>
            <p class="leading-relaxed" style="color: var(--color-text-muted);">
              Ha 1920px-nél nagyobb képet töltesz fel, automatikusan átméretezzük - nem kell külön resize-olnod. A kisebb képeket nem nagyítjuk fel. Állítható minőség (50-100%), WebP formátum.
            </p>
          </div>

          <!-- Feature 3: SEO Names -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow);">
            <div class="card-icon mb-4" style="background: var(--gradient-primary);">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">SEO-barát fájlnevek</h3>
            <p class="leading-relaxed" style="color: var(--color-text-muted);">
              Automatikus magyar ékezetek és szóközök kezelése. "Kéménytető Szigetelés.jpg" → "kemenyteto-szigeteles.webp".
            </p>
          </div>

          <!-- Feature 4: Preview -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow);">
            <div class="card-icon mb-4" style="background: var(--gradient-primary);">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">Minőség előnézet</h3>
            <p class="leading-relaxed" style="color: var(--color-text-muted);">
              Before/after csúszkával hasonlítsd össze az eredeti és tömörített képet. Látod a minőségkülönbséget és a méretcsökkenést konvertálás előtt.
            </p>
          </div>

          <!-- Feature 5: Instant Download -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow);">
            <div class="card-icon mb-4" style="background: var(--gradient-primary);">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
