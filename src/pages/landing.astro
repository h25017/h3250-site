---
import "../styles/tailwind.css";
import FileUploader from "../components/FileUploader"

const comparisons = [
  {
    category: "Teljesítmény",
    wordpress: "Lassú PHP renderelés, adatbázis lekérdezések minden oldalletöltésnél",
    astro: "Statikus generálás build időben, CDN edge-en szolgálva ~100ms alatt",
    iconColor: "#6366F1"
  },
  {
    category: "Biztonság",
    wordpress: "Gyakori biztonsági rések, plugin függőségek, állandó frissítések",
    astro: "Headless architektúra, izolált backend, minimális támadási felület",
    iconColor: "#10B981"
  },
  {
    category: "Fejlesztői élmény",
    wordpress: "Elavult PHP ökoszisztéma, korlátozott modern tooling",
    astro: "Modern JavaScript/TypeScript, Vite, Git workflow, hot reload",
    iconColor: "#8B5CF6"
  },
  {
    category: "Költség",
    wordpress: "Drága hosting, plugin licenszek, karbantartási időigény",
    astro: "Serverless, Vercel/Netlify free tier, skálázható költség",
    iconColor: "#F59E0B"
  },
  {
    category: "Testreszabhatóság",
    wordpress: "Theme és plugin korlátok, hackes megoldások",
    astro: "Teljes kontroll, bármilyen frontend framework, custom API",
    iconColor: "#EC4899"
  },
  {
    category: "SEO",
    wordpress: "Plugin-függő, lassú betöltés rontja a rangsorolást",
    astro: "Beépített optimalizáció, gyors = kiváló Core Web Vitals",
    iconColor: "#14B8A6"
  }
];

const features = [
  { title: "API-First", desc: "RESTful és GraphQL támogatás Strapival" },
  { title: "Git-Based", desc: "Verziókezelés, preview deploy-ok automatán" },
  { title: "Modern Stack", desc: "TypeScript, Tailwind, Vite - 2026-ready" },
  { title: "Edge CDN", desc: "Globális kiszolgálás milliszekundumok alatt" },
  { title: "Headless CMS", desc: "Strapi admin UI + Astro frontend = rugalmasság" },
  { title: "Cost-Effective", desc: "Kevesebb szerver, kevesebb költség, több teljesítmény" }
];
---
<html lang="hu" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WordPress vs Astro+Strapi – A jövő már itt van</title>
    <meta name="description" content="Miért váltanak a modern csapatok WordPressről Astro+Strapi stackre? Teljesítmény, biztonság, fejlesztői élmény – részletes összehasonlítás." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --color-primary: #6366F1;
        --color-accent: #10B981;
        --color-danger: #EF4444;
        --color-bg: #FAFAFA;
        --color-surface: #FFFFFF;
        --color-text: #0F172A;
        --color-text-muted: #64748B;
        --color-border: #E2E8F0;
        --font-display: 'Outfit', sans-serif;
        --font-body: 'DM Sans', sans-serif;
        --radius: 16px;
        --shadow: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      }

      :root.dark {
        --color-primary: #818CF8;
        --color-accent: #34D399;
        --color-danger: #F87171;
        --color-bg: #0F172A;
        --color-surface: #1E293B;
        --color-text: #F1F5F9;
        --color-text-muted: #94A3B8;
        --color-border: #334155;
        --shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
        --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
      }

      @media (prefers-color-scheme: dark) {
        :root:not(.light) {
          --color-primary: #818CF8;
          --color-accent: #34D399;
          --color-danger: #F87171;
          --color-bg: #0F172A;
          --color-surface: #1E293B;
          --color-text: #F1F5F9;
          --color-text-muted: #94A3B8;
          --color-border: #334155;
          --shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
          --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
        }
      }

      /* Smooth transitions for theme changes */
      * {
        transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
      }

      /* Micro-interactions */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes scaleIn {
        from {
          opacity: 0;
          transform: scale(0.98) translateY(10px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes shimmer {
        0% {
          background-position: -1000px 0;
        }
        100% {
          background-position: 1000px 0;
        }
      }

      .animate-fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
      }

      .animate-scale-in {
        animation: scaleIn 0.5s ease-out forwards;
      }

      .delay-100 { animation-delay: 0.1s; opacity: 0; }
      .delay-200 { animation-delay: 0.2s; opacity: 0; }
      .delay-300 { animation-delay: 0.3s; opacity: 0; }
      .delay-400 { animation-delay: 0.4s; opacity: 0; }
      .delay-500 { animation-delay: 0.5s; opacity: 0; }
      .delay-600 { animation-delay: 0.6s; opacity: 0; }

      /* Bento card hover effects */
      .bento-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .bento-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
      }

      .bento-card:hover .card-icon {
        transform: scale(1.05);
      }

      .card-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* Button hover effects */
      .btn-primary {
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        transition: left 0.6s ease;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(99, 102, 241, 0.3);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      .btn-primary:hover::before {
        left: 100%;
      }

      .btn-secondary {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .btn-secondary:hover {
        transform: translateY(-2px);
        background-color: var(--color-secondary);
        color: var(--color-on-secondary);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
      }

      .btn-secondary:active {
        transform: translateY(0);
      }

      /* Dark mode toggle */
      .theme-toggle {
        width: 56px;
        height: 28px;
        border-radius: 14px;
        background: var(--color-border);
        position: relative;
        cursor: pointer;
        transition: background 0.3s;
      }

      .theme-toggle:hover {
        background: var(--color-primary);
      }

      .theme-toggle::after {
        content: '🌙';
        position: absolute;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--color-surface);
        top: 2px;
        left: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow);
      }

      :root.dark .theme-toggle::after {
        left: 30px;
        content: '☀️';
      }

      /* Gradient text */
      .gradient-text {
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Badge shimmer effect */
      .badge-shimmer {
        background: linear-gradient(90deg,
          var(--color-primary) 0%,
          var(--color-accent) 50%,
          var(--color-primary) 100%
        );
        background-size: 200% 100%;
        animation: shimmer 3s infinite;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Navigation link hover */
      .nav-link {
        position: relative;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
        transition: width 0.3s ease;
      }

      .nav-link:hover::after {
        width: 80%;
      }

      .nav-link:hover {
        color: var(--color-primary) !important;
        transform: translateY(-1px);
      }

      /* Comparison card interactions */
      .comparison-card .wp-section {
        transition: all 0.3s ease;
      }

      .comparison-card .astro-section {
        transition: all 0.3s ease;
      }

      .comparison-card:hover .wp-section {
        transform: translateX(-4px);
        opacity: 0.8;
      }

      .comparison-card:hover .astro-section {
        transform: translateX(4px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
      }

      /* Dark mode navigation */
      :root.dark nav {
        background: linear-gradient(to bottom, var(--color-surface) 0%, rgba(30, 41, 59, 0.95) 100%) !important;
      }
    </style>
    <script>
      // Dark mode toggle
      const initTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const html = document.documentElement;

        if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
          html.classList.add('dark');
          html.classList.remove('light');
        } else if (savedTheme === 'light') {
          html.classList.add('light');
          html.classList.remove('dark');
        }
      };

      const toggleTheme = () => {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');

        if (isDark) {
          html.classList.remove('dark');
          html.classList.add('light');
          localStorage.setItem('theme', 'light');
        } else {
          html.classList.remove('light');
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      };

      // Initialize on load
      initTheme();

      // Attach toggle handler
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('theme-toggle');
        if (toggle) {
          toggle.addEventListener('click', toggleTheme);
        }
      });
    </script>
    <script>
      // @ts-ignore
      import Alpine from 'alpinejs';
      // @ts-ignore
      window.Alpine = Alpine;
      Alpine.start();
    </script>
    <script>
      // @ts-ignore
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      // Initialize Lenis smooth scroll
      // @ts-ignore
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
        infinite: false,
      });

      // Request animation frame loop
      // @ts-ignore
      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Anchor link smooth scrolling
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
          // @ts-ignore
          anchor.addEventListener('click', function (e) {
            // @ts-ignore
            const href = this.getAttribute('href');
            if (href && href !== '#') {
              e.preventDefault();
              const target = document.querySelector(href);
              if (target) {
                lenis.scrollTo(target, {
                  offset: -80,
                  duration: 1.5
                });
              }
            }
          });
        });
      });
    </script>
  </head>
  <body class="min-h-full antialiased" style="background-color: var(--color-bg); color: var(--color-text); font-family: var(--font-body);">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 backdrop-blur-xl" style="background: linear-gradient(to bottom, var(--color-surface) 0%, rgba(255, 255, 255, 0.95) 100%); border-bottom: 1px solid var(--color-border); box-shadow: var(--shadow);" x-data="{ mobileMenuOpen: false }">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="text-xl font-bold transition-all duration-300 hover:opacity-80" style="font-family: var(--font-display); color: var(--color-text);">
            <span class="gradient-text">Modern</span>Stack
          </a>

          <!-- Desktop Nav -->
          <div class="hidden md:flex items-center gap-6">
            <a href="#comparison" class="nav-link text-sm font-semibold relative px-3 py-2 rounded-lg" style="color: var(--color-text);">
              Összehasonlítás
            </a>
            <a href="#features" class="nav-link text-sm font-semibold relative px-3 py-2 rounded-lg" style="color: var(--color-text);">
              Előnyök
            </a>
            <a href="#cta" class="nav-link text-sm font-semibold relative px-3 py-2 rounded-lg" style="color: var(--color-text);">
              Kezdés
            </a>
            <div id="theme-toggle" class="theme-toggle ml-2"></div>
          </div>

          <!-- Mobile Menu Button -->
          <button
            @click="mobileMenuOpen = !mobileMenuOpen"
            class="md:hidden flex flex-col gap-1.5 w-10 h-10 items-center justify-center rounded-lg hover:opacity-70 transition-opacity"
            style="background-color: var(--color-surface);"
          >
            <span class="w-5 h-0.5 transition-all" style="background-color: var(--color-text);" :class="{ 'rotate-45 translate-y-2': mobileMenuOpen }"></span>
            <span class="w-5 h-0.5 transition-all" style="background-color: var(--color-text);" :class="{ 'opacity-0': mobileMenuOpen }"></span>
            <span class="w-5 h-0.5 transition-all" style="background-color: var(--color-text);" :class="{ '-rotate-45 -translate-y-2': mobileMenuOpen }"></span>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div
        x-show="mobileMenuOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 scale-100"
        x-transition:leave-end="opacity-0 scale-95"
        @click.away="mobileMenuOpen = false"
        class="md:hidden absolute left-0 right-0 px-4 pb-4"
        style="background-color: var(--color-bg); border-bottom: 1px solid var(--color-border); z-index: 100; top: 100%; transform-origin: top center;"
      >
        <div class="flex flex-col gap-2 py-4">
          <a href="#comparison" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-lg text-sm font-medium transition-colors" style="background-color: var(--color-surface); color: var(--color-text);">Összehasonlítás</a>
          <a href="#features" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-lg text-sm font-medium transition-colors" style="background-color: var(--color-surface); color: var(--color-text);">Előnyök</a>
          <a href="#cta" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-lg text-sm font-medium transition-colors" style="background-color: var(--color-surface); color: var(--color-text);">Kezdés</a>
          <div class="flex items-center justify-between px-4 py-3 rounded-lg" style="background-color: var(--color-surface);">
            <span class="text-sm font-medium" style="color: var(--color-text);">Téma</span>
            <div id="theme-toggle-mobile" class="theme-toggle" onclick="toggleTheme()"></div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-20 pb-32 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-4xl mx-auto">
          <div class="inline-block px-4 py-2 rounded-full text-xs font-semibold mb-6 animate-fade-in-up" style="background-color: var(--color-surface); color: var(--color-primary); box-shadow: var(--shadow);">
            <span class="badge-shimmer">2026-Ready Tech Stack</span>
          </div>

          <h1 class="text-5xl md:text-7xl font-bold mb-6 animate-fade-in-up delay-100" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.1;">
            WordPress vagy<br/>
            <span class="gradient-text">Astro+Strapi?</span>
          </h1>

          <p class="text-xl md:text-2xl mb-12 animate-fade-in-up delay-200" style="color: var(--color-text-muted);">
            Miért váltanak a modern csapatok? Teljesítmény, biztonság, fejlesztői élmény –<br class="hidden md:block"/>
            <strong style="color: var(--color-text);">részletes összehasonlítás.</strong>
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up delay-300">
            <a
              href="#comparison"
              class="btn-primary px-8 py-4 rounded-xl text-base font-semibold"
              style="background-color: var(--color-primary); color: white; box-shadow: var(--shadow-lg);"
            >
              Megnézem az összehasonlítást →
            </a>
            <a
              href="#features"
              class="btn-secondary px-8 py-4 rounded-xl text-base font-semibold"
              style="background-color: var(--color-surface); color: var(--color-text); border: 2px solid var(--color-border);"
            >
              Miért Astro+Strapi?
            </a>
			
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-8 mt-20 animate-fade-in-up delay-400">
            <div>
              <div class="text-4xl font-bold gradient-text" style="font-family: var(--font-display);">10x</div>
              <div class="text-sm mt-2" style="color: var(--color-text-muted);">Gyorsabb</div>
            </div>
            <div>
              <div class="text-4xl font-bold gradient-text" style="font-family: var(--font-display);">50%</div>
              <div class="text-sm mt-2" style="color: var(--color-text-muted);">Olcsóbb</div>
            </div>
            <div>
              <div class="text-4xl font-bold gradient-text" style="font-family: var(--font-display);">100%</div>
              <div class="text-sm mt-2" style="color: var(--color-text-muted);">Modern</div>
            </div>
          </div>
        </div>
		<FileUploader client:load />
      </div>
    </section>

    <!-- What is Astro + Strapi -->
    <section class="py-20 px-4 sm:px-6 lg:px-8" style="background-color: var(--color-surface);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text);">
            Mi az <span class="gradient-text">Astro + Strapi</span>?
          </h2>
          <p class="text-lg" style="color: var(--color-text-muted);">
            Két modern technológia, ami forradalmasítja a webes fejlesztést
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Astro Card -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 2px solid var(--color-border);">
            <div class="flex items-center gap-3 mb-6">
              <svg width="40" height="40" viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M163.008 18.929c1.944 2.413 2.935 5.67 4.917 12.181l43.309 142.27a180.277 180.277 0 00-51.778-17.53l-28.198-95.29a3.67 3.67 0 00-7.042.01l-27.857 95.232a180.225 180.225 0 00-52.01 17.557l43.52-142.281c1.99-6.502 2.983-9.752 4.927-12.16a15.999 15.999 0 016.484-4.798c2.872-1.154 6.271-1.154 13.07-1.154h31.085c6.807 0 10.211 0 13.086 1.157a16.004 16.004 0 016.487 4.806z" fill="#FF5D01"/>
                <path d="M168.19 180.151c-7.139 6.105-21.39 10.268-37.804 10.268-20.147 0-37.033-6.272-41.513-14.707-1.602 4.835-1.961 10.367-1.961 13.902 0 0-1.056 17.355 11.015 29.426 0-6.268 5.081-11.349 11.349-11.349 10.743 0 10.731 9.373 10.721 16.977v.679c0 11.542 7.054 21.436 17.086 25.606a23.27 23.27 0 01-2.339-10.2c0-11.008 6.463-15.107 13.974-19.87 5.976-3.79 12.616-8.001 17.294-16.871a31.59 31.59 0 001.582-17.611c-.014-.197-.03-.394-.048-.592z" fill="#FF5D01"/>
              </svg>
              <div>
                <h3 class="text-2xl font-bold" style="font-family: var(--font-display); color: var(--color-text);">Astro</h3>
                <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:opacity-70 transition-opacity" style="color: var(--color-primary);">
                  astro.build →
                </a>
              </div>
            </div>

            <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted);">
              Az <strong style="color: var(--color-text);">Astro</strong> egy modern static site generator (SSG), ami forradalmasítja a webes fejlesztést.
              A "zero JavaScript by default" filozófiával dolgozik – csak akkor tölt be JS-t, amikor tényleg szükséges.
            </p>

            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-primary);">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-sm" style="color: var(--color-text-muted);">
                  <strong style="color: var(--color-text);">Islands Architecture:</strong> Komponensek csak akkor hidratálódnak, amikor szükséges
                </p>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-primary);">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-sm" style="color: var(--color-text-muted);">
                  <strong style="color: var(--color-text);">Framework agnostic:</strong> Használj React, Vue, Svelte vagy bármi mást egy projektben
                </p>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-primary);">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-sm" style="color: var(--color-text-muted);">
                  <strong style="color: var(--color-text);">Blazing fast:</strong> Statikus oldalakat generál, amiket CDN-en szolgálhatsz
                </p>
              </div>
            </div>
          </div>

          <!-- Strapi Card -->
          <div class="bento-card p-8 rounded-2xl" style="background-color: var(--color-bg); border: 2px solid var(--color-border);">
            <div class="flex items-center gap-3 mb-6">
              <svg width="40" height="40" viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="256" height="256" rx="24" fill="#4945FF"/>
                <path d="M142.5 64H64v78.5h78.5V64z" fill="#fff"/>
                <path d="M192 64h-49.5v78.5H192V64z" opacity=".405" fill="#fff"/>
                <path d="M142.5 142.5H64V192h78.5v-49.5z" opacity=".405" fill="#fff"/>
                <path d="M192 142.5h-49.5V192H192v-49.5z" fill="#fff"/>
              </svg>
              <div>
                <h3 class="text-2xl font-bold" style="font-family: var(--font-display); color: var(--color-text);">Strapi</h3>
                <a href="https://strapi.io" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:opacity-70 transition-opacity" style="color: var(--color-primary);">
                  strapi.io →
                </a>
              </div>
            </div>

            <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted);">
              A <strong style="color: var(--color-text);">Strapi</strong> a vezető nyílt forráskódú headless CMS.
              100%-ban testreszabható, fejlesztőbarát admin panel és API, ami bármilyen frontendhez csatlakoztatható.
            </p>

            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-accent);">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-sm" style="color: var(--color-text-muted);">
                  <strong style="color: var(--color-text);">Headless CMS:</strong> Tartalom kezelés RESTful és GraphQL API-kon keresztül
                </p>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-accent);">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-sm" style="color: var(--color-text-muted);">
                  <strong style="color: var(--color-text);">Customizable:</strong> Teljesen testreszabható content types, fields és plugins
                </p>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: var(--color-accent);">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-sm" style="color: var(--color-text-muted);">
                  <strong style="color: var(--color-text);">Self-hosted:</strong> Teljes kontroll az adataid felett, saját szervereden
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Why Together -->
        <div class="mt-12 max-w-4xl mx-auto">
          <div class="p-8 rounded-2xl text-center" style="background: linear-gradient(135deg, var(--color-primary)10, var(--color-accent)10); border: 2px solid var(--color-border);">
            <h3 class="text-2xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text);">
              Miért tökéletes páros?
            </h3>
            <p class="text-base leading-relaxed" style="color: var(--color-text-muted);">
              Az <strong style="color: var(--color-text);">Astro frontend</strong> villámgyorsan generálja a statikus oldalakat,
              míg a <strong style="color: var(--color-text);">Strapi backend</strong> egyszerű tartalom kezelést biztosít.
              A kettő együtt egy <strong style="color: var(--color-text);">moduláris, skálázható és biztonságos</strong> megoldást eredményez,
              ami messze túlszárnyalja a WordPress monolitikus architektúráját.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Grid (Bento Box) -->
    <section id="comparison" class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text);">
            Részletes összehasonlítás
          </h2>
          <p class="text-lg" style="color: var(--color-text-muted);">
            Hat kritikus szempont, ami számít a modern webes projektekben
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {comparisons.map((item, index) => (
            <div
              class={`bento-card comparison-card p-8 rounded-2xl animate-scale-in delay-${(index + 1) * 100}`}
              style="background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow); overflow: hidden;"
            >
              <div class="card-icon mb-6" style={`background: linear-gradient(135deg, ${item.iconColor}15, ${item.iconColor}25);`}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  {index === 0 && (
                    <path d="M13 10V3L4 14h7v7l9-11h-7z" stroke={item.iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  )}
                  {index === 1 && (
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke={item.iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  )}
                  {index === 2 && (
                    <>
                      <rect x="2" y="3" width="20" height="14" rx="2" stroke={item.iconColor} stroke-width="2"/>
                      <path d="M8 21h8M12 17v4" stroke={item.iconColor} stroke-width="2" stroke-linecap="round"/>
                    </>
                  )}
                  {index === 3 && (
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke={item.iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  )}
                  {index === 4 && (
                    <>
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke={item.iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </>
                  )}
                  {index === 5 && (
                    <path d="M18 20V10M12 20V4M6 20v-6" stroke={item.iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  )}
                </svg>
              </div>
              <h3 class="text-xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text);">
                {item.category}
              </h3>

              <div class="space-y-4">
                <div class="wp-section p-4 rounded-lg" style="background-color: var(--color-bg); border-left: 3px solid var(--color-danger);">
                  <div class="text-xs font-semibold mb-2 uppercase tracking-wider" style="color: var(--color-danger);">WordPress</div>
                  <p class="text-sm" style="color: var(--color-text-muted);">{item.wordpress}</p>
                </div>

                <div class="astro-section p-4 rounded-lg" style="background-color: var(--color-bg); border-left: 3px solid var(--color-accent);">
                  <div class="text-xs font-semibold mb-2 uppercase tracking-wider" style="color: var(--color-accent);">Astro+Strapi</div>
                  <p class="text-sm" style="color: var(--color-text-muted);">{item.astro}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section id="features" class="py-20 px-4 sm:px-6 lg:px-8" style="background-color: var(--color-surface);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text);">
            Miért <span class="gradient-text">Astro+Strapi</span>?
          </h2>
          <p class="text-lg" style="color: var(--color-text-muted);">
            A modern fejlesztés alapkövei egy helyen
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature, index) => (
            <div
              class={`bento-card p-6 rounded-xl animate-fade-in-up delay-${(index + 1) * 100}`}
              style="background-color: var(--color-bg); border: 1px solid var(--color-border);"
            >
              <h3 class="text-lg font-bold mb-2" style="font-family: var(--font-display); color: var(--color-text);">
                {feature.title}
              </h3>
              <p class="text-sm" style="color: var(--color-text-muted);">
                {feature.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="cta" class="py-32 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-6xl font-bold mb-6" style="font-family: var(--font-display); color: var(--color-text);">
          Készen állsz a váltásra?
        </h2>
        <p class="text-xl mb-12" style="color: var(--color-text-muted);">
          Csatlakozz a modern fejlesztőkhöz, akik már nem kompromisszumokat kötnek.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#"
            class="btn-primary px-10 py-5 rounded-xl text-lg font-semibold"
            style="background-color: var(--color-primary); color: white; box-shadow: var(--shadow-lg);"
          >
            Ingyenes konzultáció
          </a>
          <a
            href="#"
            class="btn-secondary px-10 py-5 rounded-xl text-lg font-semibold"
            style="background-color: var(--color-surface); color: var(--color-text); border: 2px solid var(--color-border);"
          >
            Költségkalkulátor
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-4 sm:px-6 lg:px-8" style="border-top: 1px solid var(--color-border);">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="text-lg font-bold" style="font-family: var(--font-display);">
            <span class="gradient-text">Modern</span>Stack
          </div>
          <div class="flex gap-8 text-sm" style="color: var(--color-text-muted);">
            <a href="#" class="hover:opacity-70 transition-opacity">Adatvédelem</a>
            <a href="#" class="hover:opacity-70 transition-opacity">Feltételek</a>
            <a href="#" class="hover:opacity-70 transition-opacity">Kapcsolat</a>
          </div>
        </div>
        <div class="text-center mt-8 text-sm" style="color: var(--color-text-muted);">
          © {new Date().getFullYear()} ModernStack – Powered by Astro + Strapi
        </div>
      </div>
    </footer>
  </body>
</html>
